NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
ADMIN_EMAILS=
# Required by src/proxy.ts. Use "vercel" on Vercel. Use
# "x-forwarded-for" only behind a reverse proxy that overwrites that header.
# Leave empty to distrust forwarding headers (all clients share a fallback key).
TRUSTED_PROXY_MODE=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
BILLING_RECONCILIATION_SECRET=
BILLING_ALERT_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Development/Preview should use Stripe Test Mode values.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PREMIUM=
# Dedicated Portal configuration: payment methods, invoices, cancel/resume only.
# Product or price switching must remain disabled in this configuration.
STRIPE_PORTAL_CONFIGURATION_ID=
# Keep false until database migration and end-to-end billing validation pass.
STRIPE_CHECKOUT_ENABLED=false

# ECPay recurring credit-card billing. Keep both flags false until sandbox validation passes.
ECPAY_MODE=test
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
ECPAY_CHECKOUT_ENABLED=false
NEXT_PUBLIC_ECPAY_ENABLED=false
